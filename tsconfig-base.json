{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "noImplicitAny": false,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "compileOnSave": false,
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"],
  "include": ["src"]
}
