{
  "name": "reacto-form-inputs",
  "version": "1.2.0",
  "description": "Example React components that implement the Composable Form Specification for form inputs",
  "homepage": "https://github.com/DairyStateDesigns/reacto-form-inputs",
  "bugs": {
    "url": "https://github.com/DairyStateDesigns/reacto-form-inputs/issues"
  },
  "license": "MIT",
  "author": "Dairy State Designs (http://dairystatedesigns.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/DairyStateDesigns/reacto-form-inputs.git"
  },
  "files": [
    "CHANGELOG.md",
    "cjs",
    "esm",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js"
    },
    "./cjs/*": {
      "types": "./esm/*.d.ts",
      "default": "./cjs/*.js"
    },
    "./esm/*": {
      "types": "./esm/*.d.ts",
      "default": "./esm/*.js"
    },
    "./*": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "require": "./cjs/*.js"
    }
  },
  "scripts": {
    "build": "rm -fr cjs/* esm/* && tsc -p tsconfig-build.json && esbuild lib/*.ts lib/*.tsx lib/shared/*.ts --outbase=lib --outdir=esm --format=esm --platform=browser --target=es2022 && esbuild lib/*.ts lib/*.tsx lib/shared/*.ts --outbase=lib --outdir=cjs --format=cjs --platform=browser --target=es2015 && ./scripts/post-build.sh",
    "check": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^16.14.70",
    "babel-jest": "^30.4.1",
    "composable-form-tests": "^1.0.1",
    "core-js": "^3.45.1",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "moment-timezone": "^0.6.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.78.0",
    "raf": "^3.4.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-test-renderer": "^16.14.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "browserslist": "> 0.5%, last 2 versions, Firefox ESR, not dead",
  "jest": {
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFiles": [
      "raf/polyfill",
      "<rootDir>/jestSetup.cjs"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[tj]sx?$": [
        "babel-jest",
        {
          "presets": [
            "@babel/preset-env",
            "@babel/preset-react",
            "@babel/preset-typescript"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=20.19",
    "npm": ">=9"
  }
}
